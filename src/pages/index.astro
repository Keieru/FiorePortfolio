---
import Layout from "../layouts/Layout.astro";
import { pillars, credentials, experience } from "../data/profile";
import {
  kicker,
  sectionContainer,
  sectionHeading,
  sectionHeading2,
  btnPrimary,
  btnPrimaryNav,
  btnPrimaryLg,
  btnGhostLg,
  hr,
  entryCard,
  entryTitle,
  inputBase,
  checkboxBase,
} from "../styles/classes";
import BookingCalendar from "../components/BookingCalendar.astro";
---

<Layout
  title="Fiorella Ailen Litarelli — Psicóloga Colegiada M-45324"
  description="Acompañamiento psicológico individual con orientación cognitivo-conductual, atendiendo personas con trastornos del estado de ánimo, TCA, TEA y personas adultas mayores. Atención en Madrid, España."
>
  <div class="w-full min-h-screen">

    <nav class="sticky top-0 z-50 flex items-center gap-2 md:gap-4 py-3 px-4 md:px-8 border-b border-divider bg-bg">
      <div class="font-heading font-semibold text-[16px] md:text-[22px] mr-auto">Fiorella Ailen Litarelli</div>
      <a href="#about" class="hidden md:inline text-base no-underline text-text hover:text-accent">Sobre mí</a>
      <a href="#approach" class="hidden md:inline text-base no-underline text-text hover:text-accent">Enfoque</a>
      <a href="#experience" class="hidden md:inline text-base no-underline text-text hover:text-accent">Experiencia</a>
      <a href="#credentials" class="hidden md:inline text-base no-underline text-text hover:text-accent">Formación</a>
      <a href="#contact" class={btnPrimaryNav}>Reservar sesión</a>
    </nav>

    <div class="grid grid-cols-1 md:grid-cols-[1.1fr_0.9fr] gap-6 md:gap-8 items-center max-w-[1180px] mx-auto px-4 md:px-8 pt-6 md:pt-8 pb-9 md:pb-[55.2px]">
      <div>
        <div class="font-heading text-xs font-semibold tracking-[0.08em] uppercase text-accent-800 mb-4">Psicóloga Colegiada M-45324 · Colegio Oficial de la Psicología de Madrid (COPM) · Orientación cognitivo-conductual</div>
        <h1 class="font-heading font-semibold text-[32px] md:text-[48px] leading-[1.12] tracking-[-0.015em] mb-2">Un espacio tranquilo y seguro para trabajar lo que te pesa.</h1>
        <p class="text-[16px] md:text-[18px] leading-[1.7] max-w-[46ch] opacity-[0.85]">Acompañamiento psicológico individual desde un enfoque cognitivo-conductual, atendiendo personas con trastornos del estado de ánimo, trastornos de la conducta alimentaria (TCA), TEA y personas adultas mayores.</p>
        <div class="flex flex-col sm:flex-row gap-3 sm:items-center mt-4 max-w-[46ch]">
          <a href="#contact" class={btnPrimaryLg}>Agendar una consulta</a>
          <a href="#about" class={btnGhostLg}>Conocer más sobre mí</a>
        </div>
      </div>
      <div class="filter-[sepia(0.22)_saturate(0.82)_contrast(1.05)] box-border border-[6px] border-surface outline outline-divider flex items-center justify-center bg-surface w-full h-[300px] md:h-[460px]">
        <img src="/images/foto-fiore.jpg" alt="Foto de Fiorella Ailen Litarelli" class="w-full h-full object-cover" />
      </div>
    </div>

    <hr class={hr} />

    <section id="about" class="max-w-[1000px] mx-auto py-9 md:py-[51.52px] px-4 md:px-8 grid grid-cols-1 md:grid-cols-[0.7fr_1.3fr] gap-4 md:gap-6 scroll-mt-[84px]">
      <div>
        <div class={kicker}>Sobre mí</div>
        <h2 class={sectionHeading2}>Conocer cómo trabajas es donde empieza el cuidado.</h2>
      </div>
      <div class="text-[16px] leading-[1.85] text-left md:text-justify">
        <p>Psicóloga con orientación cognitivo-conductual, atendiendo personas con acompañamiento psicológico individual a personas con trastornos del estado de ánimo, trastornos de la conducta alimentaria (TCA), TEA y personas adultas mayores. Mi experiencia personal como persona con dislexia complementa mi formación profesional, permitiéndome ofrecer una comprensión cercana y una atención sensible a las necesidades de las personas neurodivergentes.</p>
        <p class="text-justify text-[15px] ">Fuera de la consulta, soy colaboradora en un programa de radio sobre psicología, realizo teatro, participo de un taller de literatura y me gusta realizar artesanías.</p>
        <div class="flex flex-wrap gap-y-2 gap-x-6 mt-4 text-sm opacity-80 text-left">
          <div><strong>Nacionalidad:</strong> Argentina</div>
          <div><strong>Idioma:</strong> Español</div>
          <div><strong>Disponibilidad:</strong> Inmediata</div>
        </div>
      </div>
    </section>

    <hr class={hr} />

    <section id="approach" class="max-w-[1100px] mx-auto py-9 md:py-[51.52px] px-4 md:px-8 scroll-mt-[84px]">
      <div class="text-center mb-6 md:mb-8">
        <div class={kicker}>Mi enfoque</div>
        <h2 class={sectionHeading2}>Basado en la evidencia. Diseñado para ti.</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {pillars.map((pillar) => (
          <div class="flex flex-col gap-2 p-3 rounded-md bg-transparent border border-divider">
            <div class="text-[10px] tracking-widest uppercase text-accent">{pillar.n}</div>
            <div class="font-heading font-semibold text-[17px] leading-[1.2]">{pillar.title}</div>
            <p class="m-0 text-[13px] opacity-80 flex-1">{pillar.body}</p>
          </div>
        ))}
      </div>
    </section>

    <hr class={hr} />

    <section id="experience" class={sectionContainer}>
      <div class={kicker}>Experiencia profesional</div>
      <h2 class={sectionHeading}>Un acompañamiento con base real.</h2>
      <div class="flex flex-col gap-6">
        {experience.map((job) => (
          <div class={entryCard}>
            <div class={entryTitle}>{job.title}</div>
            <div class="font-heading text-sm text-accent-700 mb-2">{job.place} · {job.period}</div>
            <ul class="m-0 pl-[1.1em] text-[15px] leading-[1.7] opacity-[0.85]">
              {job.bullets.map((bullet) => (
                <li>{bullet}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </section>

    <hr class={hr} />

    <section id="credentials" class={sectionContainer}>
      <div class={kicker}>Formación y credenciales</div>
      <h2 class={sectionHeading}>Una formación en la que puedes confiar.</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-8 gap-y-6">
        {credentials.map((cred) => (
          <div class={entryCard}>
            <div class="font-heading text-xs text-accent-700 mb-[4px]">{cred.year}</div>
            <div class={entryTitle}>{cred.title}</div>
            {cred.detail && <div class="text-sm opacity-75">{cred.detail}</div>}
          </div>
        ))}
      </div>
    </section>

    <hr class={hr} />

    <section id="contact" class="max-w-[1000px] mx-auto py-9 md:py-[51.52px] px-4 md:px-8 scroll-mt-[84px]">
      <div class="mb-6 md:mb-8 max-w-[60ch]">
        <div class={kicker}>Ponte en contacto</div>
        <h2 class={sectionHeading2}>Dar el primer paso suele ser lo más difícil. Este es solo una conversación.</h2>
        <p class="text-[15px] opacity-80 mt-3">Elige el día y la hora que mejor te vengan y te confirmaré la cita por correo a la brevedad.</p>
        <p class="text-[13px] opacity-65 mt-2">Sesiones de lunes a viernes, de 10:00 a 18:00 (hora de Madrid).</p>
      </div>
      {/*
        Móvil: una sola columna (nombre, email, calendario, resto). El contenedor de la derecha
        usa `contents` para que sus hijos se ordenen junto al calendario con `order-*`.
        Escritorio (md+): calendario a la izquierda y formulario a la derecha.
      */}
      <form id="contact-form" class="flex flex-col gap-3 md:grid md:grid-cols-2 md:gap-x-8 md:items-start">
        <div class="hidden" aria-hidden="true">
          <label for="website">No rellenes este campo</label>
          <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
        </div>
        <div class="order-2 min-w-0 md:col-start-1 md:row-start-1">
          <BookingCalendar />
        </div>
        <div class="contents md:flex md:flex-col md:gap-3 md:col-start-2 md:row-start-1">
          <div class="order-1 flex flex-col gap-3">
            <div>
              <label for="name" class="block text-xs mb-[5px] text-text/70">Tu nombre</label>
              <input type="text" id="name" name="name" class={inputBase} placeholder="Nombre completo" required />
            </div>
            <div>
              <label for="email" class="block text-xs mb-[5px] text-text/70">Correo electrónico</label>
              <input type="email" id="email" name="email" class={inputBase} placeholder="tucorreo@ejemplo.com" required />
            </div>
          </div>
          <div class="order-3 flex flex-col gap-3">
            <div>
              <label for="message" class="block text-xs mb-[5px] text-text/70">¿Qué te trae por aquí? <span class="opacity-75">(opcional)</span></label>
              <textarea id="message" name="message" rows="4" class={`${inputBase} min-h-[90px] resize-y`} placeholder="Cuéntame un poco, sin entrar en detalles de salud..."></textarea>
            </div>
            <label class="flex items-start gap-2 text-[13px] leading-[1.5] cursor-pointer">
              <input type="checkbox" id="privacy" name="acepta_privacidad" value="sí" class={checkboxBase} required />
              <span>He leído y acepto la <a href="/privacidad" target="_blank" rel="noopener" class="text-accent-700 underline">Política de Privacidad</a> y consiento el tratamiento de mis datos para gestionar mi solicitud de cita.</span>
            </label>
            <div id="booking-error" class="text-[13px] text-[#b3261e]" hidden>Elige un día y una hora para tu cita.</div>
            <button type="submit" class={`${btnPrimary} w-full mt-2 disabled:opacity-[0.45] disabled:cursor-not-allowed`}>Solicitar cita</button>
            <div id="contact-success" class="text-[13px] text-accent-700 hidden">Solicitud enviada — te confirmaré la cita por correo.</div>
            <div id="contact-error" class="text-[13px] text-[#b3261e] hidden" role="alert"></div>
          </div>
        </div>
      </form>
    </section>

    <footer class="border-t border-divider py-4 px-4 md:px-8 flex flex-col sm:flex-row justify-between items-start sm:items-center gap-4 text-[13px] opacity-[0.65]">
      <div>
        <div>© 2026 Fiorella Ailen Litarelli</div>
        <div>Colegiada M-45324 · Colegio Oficial de la Psicología de Madrid (COPM)</div>
        <a href="/privacidad" class="text-text underline">Política de Privacidad</a>
      </div>
      <div class="flex items-center gap-2">
        <span class="text-[11px] text-right max-w-[110px]">Escanea para verificar el perfil de Fiorella colegio Madrid</span>
        <img src="/images/colegiada-qr.jpeg" alt="Código QR para verificar el perfil de Fiorella Ailen Litarelli como psicóloga colegiada" class="w-[52px] h-[52px] rounded-sm" />
      </div>
    </footer>

  </div>

  <script>
    import { booking } from "../data/booking";

    const form = document.getElementById("contact-form");
    const success = document.getElementById("contact-success");
    const error = document.getElementById("contact-error");
    const bookingError = document.getElementById("booking-error");
    const calendar = document.getElementById("booking-calendar");

    const MESSAGES = {
      generic: "No se pudo enviar la solicitud. Inténtalo de nuevo o escríbeme por correo.",
      taken: "Lo siento, alguien acaba de solicitar esa hora. Elige otra, por favor.",
      invalid: "Revisa los datos del formulario: alguno no es válido.",
      rate_limited: "Ya he recibido una solicitud tuya recientemente. Te responderé pronto; si necesitas cambiarla, escríbeme por correo.",
    };

    const showError = (msg: string) => {
      if (!error) return;
      error.textContent = msg;
      error.style.display = "block";
    };

    calendar?.addEventListener("booking:change", () => {
      if (bookingError) bookingError.hidden = true;
    });

    if (form instanceof HTMLFormElement) {
      const submitButton = form.querySelector('button[type="submit"]');

      form.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (success) success.style.display = "none";
        if (error) error.style.display = "none";

        const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
        if (!data.fecha || !data.hora) {
          if (bookingError) bookingError.hidden = false;
          calendar?.scrollIntoView({ behavior: "smooth", block: "center" });
          return;
        }
        if (!booking.apiUrl) {
          showError(MESSAGES.generic);
          return;
        }
        if (submitButton instanceof HTMLButtonElement) submitButton.disabled = true;

        try {
          // text/plain evita la petición previa CORS que Apps Script no admite.
          const response = await fetch(booking.apiUrl, {
            method: "POST",
            headers: { "Content-Type": "text/plain;charset=utf-8" },
            body: JSON.stringify(data),
          });
          const result = await response.json().catch(() => ({}));
          const slot = { fecha: data.fecha, hora: data.hora };

          if (result.ok) {
            if (success) success.style.display = "block";
            form.reset();
            calendar?.dispatchEvent(new CustomEvent("booking:reset"));
            calendar?.dispatchEvent(new CustomEvent("booking:taken", { detail: slot }));
          } else if (result.error === "taken") {
            showError(MESSAGES.taken);
            calendar?.dispatchEvent(new CustomEvent("booking:taken", { detail: slot }));
            calendar?.scrollIntoView({ behavior: "smooth", block: "center" });
          } else {
            showError(
              result.error === "invalid" ? MESSAGES.invalid
              : result.error === "rate_limited" ? MESSAGES.rate_limited
              : MESSAGES.generic,
            );
          }
        } catch {
          showError(MESSAGES.generic);
        } finally {
          if (submitButton instanceof HTMLButtonElement) submitButton.disabled = false;
        }
      });
    }
  </script>
</Layout>
